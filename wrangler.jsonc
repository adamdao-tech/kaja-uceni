{
  "name": "kaja-uceni",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "d1_databases": [{ "binding": "DB", "database_name": "kaja-uceni" }],
  "kv_namespaces": [{ "binding": "OAUTH_KV" }]
}
